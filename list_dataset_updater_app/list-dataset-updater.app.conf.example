id: "list-dataset-updater"
version: "1.0.0"
name: "List Dataset Updater"
provider: "Alex Golunov"
description: "Append validated IDs to a versioned ClearML dataset"
icon: "${ASSET:app-list-dataset-updater@2x.png}"
badges: []
details_page: "task"

task {
  script {
    repository: "https://github.com/golunovas/clrml-custom-apps.git"
    entry_point: "update_list_dataset.py"
    working_dir: "list_dataset_updater_app"
    tag: ""
  }
  hyperparams {
    Args {
      ids: ""
      reference: ""
      dataset_project: "<dataset project>"
      dataset_name: "<dataset name>"
      id_pattern: "^[A-Za-z0-9_-]+$"
      lowercase: "false"
    },
  }
}

wizard {
  entries: [
    {
      type: multiline_text
      name: ids
      title: IDs
      info: "IDs to add, separated by newlines, spaces or commas"
      required: true
      target {
        field: hyperparams
        section: Args
        name: ids
      }
    },
    {
      type: string
      name: reference
      title: Reference
      info: "Ticket or reference stored with every added ID"
      required: true
      target {
        field: hyperparams
        section: Args
        name: reference
      }
    }
  ]
}

dashboard {
  lines: [
    {
      contents: [
        {
          title: "Summary"
          type: plot
          metric: "List update"
          variant: "Summary"
        }
      ]
    },
    {
      contents: [
        {
          title: "Added IDs"
          type: plot
          metric: "List update"
          variant: "Added"
        }
      ]
    },
    {
      contents: [
        {
          title: "Rejected input"
          type: plot
          metric: "List update"
          variant: "Rejected"
        }
      ]
    }
  ]
}
